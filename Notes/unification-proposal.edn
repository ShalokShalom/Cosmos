 :problem
 ["The host unifier is a closed-record, closed-effect unifier. It cannot represent an open row, an open effect set, or a function whose effects depend on an argument."
  "RowTypes and LabelSets exist but are not part of one unification model. A row term and a set term cannot meet, but nothing states that boundary in the type system."
  "The concatenated language can express the unification algorithm once it has row and set terms. Without them the self-hosted unifier cannot represent open structural types or effect tails."
  "The host and the self-hosted unifier need one reference semantics so they can be compared by tests instead of by prose."]

 :target-model
 {:principle "one dispatcher, three kinds, no cross-kind binding"
  :kinds
  {:type "type terms: variables, primitives, sorts, records, functions"
   :row "data rows: ordered labels with an optional nominal tail"
   :set "effect sets: unordered labels with an optional nominal remainder"}
  :variables
  {:type "TypeVariable of int"
   :row "RowVariable of int"
   :set "SetVariable of int"
   :rule "the three namespaces are nominal; a type variable never binds a row or set term"}
  :invariants
  ["No unifier binds a variable of one kind to a term of another kind."
   "A row and a set never unify, even when their labels are identical."
   "Records use closed label sets in this slice; rows carry labels only."
   "Effects use sets; a function's effect set is its own requirement."
   "Every refusal is a named value, never an exception and never a string."
   "The adapter agrees with the host unifier on a closed record; the self-hosted fixture returns the expected host-model verdicts."]}

 :term-grammar
 {:host
  {:type
   ["Variable of TypeVariable"
    "Primitive of string"
    "Sort of string"
    "Record of Map<string, Type>"
    "Function of Type list * Type * LabelSets.LabelSet<string>"]
   :row
   ["Empty"
    "Extend of string * Row"
    "Variable of RowVariable"]
   :set
   ["Closed of Set<string>"
    "Open of Set<string> * SetVariable"]}
  :self-hosted
  [{:shape "nil"}
   {:shape "cons" :fields ["head" "tail"]}
   {:shape "tvar" :fields ["id"]}
   {:shape "prim" :fields ["name"]}
   {:shape "rec" :fields ["fields"]}
   {:shape "field" :fields ["name" "type"]}
   {:shape "fn" :fields ["params" "result" "effects"]}
   {:shape "rowempty"}
   {:shape "rowextend" :fields ["label" "rest"]}
   {:shape "rowvar" :fields ["id"]}
   {:shape "setclosed" :fields ["labels"]}
   {:shape "setopen" :fields ["labels" "id"]}
   {:shape "setvar" :fields ["id"]}
   {:shape "pair" :fields ["left" "right"]}
   {:shape "ok" :fields ["value" "next"]}
   {:shape "error" :fields ["reason"]}]
  :representation
  ["lists are cons cells; the empty list is nil"
   "a substitution is a list of pair terms"
   "a record is a list of field terms; its labels are derived from the field names"
   "a row is rowextend/rowempty/rowvar"
   "a set is setclosed/setopen over a label list"
   "the result is ok(value, next) or error(reason)"]}

 :unifier-state
 {:host
  {:types "Map<TypeVariable, Type>"
   :effects "LabelSets.SetSubstitution<string>"
   :rows "RowTypes.RowSubstitution<string>"
   :next "one monotone integer per kind; the host adapter currently shares the type counter"}
  :self-hosted
  {:substitution "list of pair terms"
   :next "an integer threaded through every call"
   :rule "state is a value; no mutation"}}

 :type-unification
 {:inputs [:left :right :state]
  :outputs [:ok-state :error]
  :rules
  [{:when "both Variable with the same identity" :then "ok, unchanged"}
   {:when "Variable v and term t" :then "occurs check; bind v to t"}
   {:when "both Primitive with equal name" :then "ok, unchanged"}
   {:when "both Sort with equal name" :then "ok, unchanged"}
   {:when "both Record" :then "record-unification"}
   {:when "both Function" :then "function-unification"}
   {:otherwise "TypeMismatch"}]
  :refusals
  ["OccursCheck"
   "TypeMismatch"
   "ArityMismatch"
   "EffectMismatch"
   "KindMismatch"]}

 :record-unification
 {:inputs [:left :right :state]
  :outputs [:ok-state :error]
  :rules
  [{:when "the label sets differ" :then "TypeMismatch with context record fields"}
   {:when "the label sets are equal" :then "unify the payloads in key order; the record keeps the closed label set"}
   {:when "a payload unification fails" :then "return that failure unchanged"}]
  :invariants
  ["a record is closed in this slice"
   "the field map keys equal the label set"
   "field order is presentation only"
   "payloads unify with the type unifier, never with the row or set unifier"]
  :future
  {:open-records
   {:status :deferred
    :reason "an open record must carry payloads for labels absorbed by a row variable; that is a separate design decision"
    :shape "a record would be a row of field terms, where a field is a name and a type"}}}

 :function-unification
 {:inputs [:left :right :state]
  :outputs [:ok-state :error]
  :rules
  [{:when "the parameter counts differ" :then "ArityMismatch"}
   {:when "the parameter counts match" :then "unify parameters pairwise and then results"}
   {:when "the effect sets are present" :then "unify effects with the set unifier"}
   {:when "an effect unification fails" :then "EffectMismatch with context function effects"}]
  :effect-polymorphism
  {:status "done"
   :mechanism "function effects are LabelSets.LabelSet<string>; a Scheme quantifies both TypeVariable and SetVariable; instantiation freshens both"
   :rule "a function with an open effect set unifies with a function with concrete effects by binding the set variable"
   :contextual
   "A call unions the callee's effects with the argument-expression effects. A function argument's latent effects are carried by its function type and are bound through set unification; they are not double-counted because evaluating a function literal has no effects."}
  :refusals
  ["ArityMismatch"
   "EffectMismatch"
   "OccursCheck"]}

 :row-unification
 {:inputs [:left :right :substitution :next-variable]
  :outputs [:ok-substitution-next :error]
  :rules
  [{:when "both Empty" :then "ok"}
   {:when "both Extend with equal labels" :then "unify the tails"}
   {:when "both Extend with different labels" :then "rewrite: find the left label in the right tail and the right label in the left tail; unify the remainders; fail if either label is missing"}
   {:when "Variable v and row r" :then "occurs check; bind v to r"}
   {:when "row r and Variable v" :then "symmetric"}
   {:when "Variable v1 and Variable v2" :then "bind one to the other"}
   {:when "only one side has labels and the other side has a Variable tail" :then "bind the tail to the extra labels plus the other side's tail"}
   {:when "only one side has labels and the other side is closed" :then "Mismatch"}]
  :invariants
  ["labels are a set for equality; order is presentation only"
   "no duplicate label"
   "occurs check prevents a cyclic row"
   "closed-first: open rows are introduced only by a consumer"
   "no lacks constraint; set semantics plus the duplicate check does that work"]
  :refusals
  ["OccursCheck"
   "Mismatch"
   "DuplicateLabel"]}

 :set-unification
 {:inputs [:left :right :substitution :next-variable]
  :outputs [:ok-substitution-next :error]
  :rules
  [{:when "Closed a and Closed b" :then "a = b"}
   {:when "Open(known, v) and Closed b" :then "known is a subset of b; bind v to b - known"}
   {:when "Closed a and Open(known, v)" :then "symmetric"}
   {:when "Open(k1, v1) and Open(k2, v2) with v1 = v2" :then "k1 = k2"}
   {:when "Open(k1, v1) and Open(k2, v2) with v1 != v2" :then "allocate one fresh unknown; bind v1 to k2 - k1 plus the unknown; bind v2 to k1 - k2 plus the unknown"}
   {:when "a known set is not a subset" :then "Mismatch"}]
  :invariants
  ["no order"
   "no duplicate label"
   "set idempotence"
   "occurs check"
   "a set variable and a row variable never meet"]
  :refusals
  ["OccursCheck"
   "Mismatch"]}

 :kind-dispatch
 {:rule "the caller names the kind; the dispatcher refuses a term of another kind"
  :surface
  ["unifyType : TypeTerm -> TypeTerm -> State -> Result<State, UnificationError>"
   "unifyRow : Row<string> -> Row<string> -> State -> Result<State, UnificationError>"
   "unifySet : LabelSet<string> -> LabelSet<string> -> State -> Result<State, UnificationError>"
   "unifyKinded : KindedTerm -> KindedTerm -> State -> Result<State, UnificationError>"]
  :refusal "KindMismatch of left-kind, right-kind, context"}

 :host-adapter
 {:purpose "connect the existing closed host types to the kinded model without changing the host inference loop in this slice"
  :mapping
  {:TypeRetrieval.Variable "Unification.Variable"
   :TypeRetrieval.Primitive "Unification.Primitive"
   :TypeRetrieval.Sort "Unification.Sort"
   :TypeRetrieval.Record "Unification.Record with a closed label set and a field map"
   :TypeRetrieval.Function "Unification.Function with a closed effect set"}
  :direction "both ways for the closed fragment"
  :acceptance "the adapter and the host unifier agree on a closed record check"}

 :self-hosted-unifier
 {:purpose "express the same algorithm in the concatenated language, with rows and sets as values"
  :terms "the shapes in :term-grammar :self-hosted"
  :state "a substitution is a list of pair terms; next is an integer"
  :entry "unify(left right subst next) returns ok(value next) or error(reason)"
  :algorithm
  ["walk applies the substitution until the term is not a bound variable"
   "occurs walks the term and tests variable identity"
   "unify dispatches with a nested match on the left and right constructors"
   "unifyRow implements the row rules"
   "unifySet implements the set rules"
   "unifyRecord unifies the label sets and then the field payloads"
   "unifyFunction unifies parameters, result, and effects"
   "every refusal returns an error shape with a named reason"]
  :language-use
  {:match "nested match on shapes; the fixture does not use generic dispatch"
   :lists "cons cells and recursion for parameters, fields, labels, and substitutions"
   :result "ok and error shapes; no exceptions"
   :fail "Fail is not used; every refusal is an error shape"}
  :limits
  ["the self-hosted unifier is a program, not the host checker"
   "it does not type itself"
   "it covers the closed fragment plus open rows and open sets"
   "handlers are out of scope"]
  :differential
  {:corpus "a shared corpus of type variables, primitives, functions, closed records, rows, and sets"
   :oracle "the host Unification module; the fixture encodes the expected verdicts"
   :checks ["the same ok or error verdict"
            "the fixture checks the fresh-set counter"
            "no exception on any corpus case"]}}

