 :directions
 {  :open-records
  {:choice "payload-aware record row (row-carried fields)"
   :status :done
   :reuses ["RowTypes tail/label mechanics" "unifyType"]
   :why "one row engine serves records and variants; the record layer unifies common payloads with unifyType"
   :cost "custom label comparison, a payload-aware RecordRow unifier, a payload-conflict rule, and a field-access consumer"
   :critical "plain RowTypes.unify does not unify payloads; name-only label equality alone would ignore field-type differences"}
  :handlers
  {:choice "target: deep multi-shot with second-class blocks; next slice: shallow one-shot with explicit handler values"
   :effect-subtraction :done
   :runtime "shallow one-shot with-handler and signal"
   :reuses ["LabelSets" "Function"]
   :why "deep multi-shot is the most expressive target; shallow one-shot is the most shared feasible slice"
   :cost "continuation capture and runtime handler stack for deep multi-shot; shallow one-shot pins semantics first"
   :critical "deep multi-shot is the least shared option; the current evaluator has no continuation capture"}
  :second-class
  {:choice "Block alongside Function, gated on a mandatory checked path or runtime block restriction"
   :reuses ["parameters" "result" "effects" "application"]
   :why "keeps first-class closures while adding precise block typing for handlers"
   :cost "two callable forms, conversion rules, and enforcement"
   :critical "an optional type checker cannot enforce second-class; the runtime can still store a closure"}
  :word-effects
  {:choice "WordSignature.Effects becomes EffectSet plus QuantifiedEffects"
   :status :done
   :reuses ["Scheme" "generalize" "instantiate"]
   :why "removes the last closed-only special case and gives builtins full effect polymorphism"
   :cost "a field on every signature constructor, an Effects type change, and more registry tests"
   :critical "QuantifiedEffects alone is insufficient; Set<string> cannot contain a set variable"}
  :self-typing
  {:choice "typed unifier plus bootstrap, gated on a user-facing signature surface; the fixture remains the oracle"
   :reuses ["host checker" "book language" "differential fixture"]
   :why "the unifier becomes a checked Scale artifact rather than only a fixture"
   :cost "annotations, a bootstrap plan, and a larger test surface"
   :critical "the language has no user-facing signature syntax; bootstrap is research, not a vertical slice"}
  :rows
  {:choice "lacks constraints when needed; AC is implicit"
   :reuses ["RowTypes" "set-based label equality"]
   :why "set equality already gives permutation-insensitive labels; lacks adds negative information without a second AC engine"
   :cost "solver state and occur/apply rules for negative labels"}
  :performance
  {:choice "shared Map/Set representation, profile-driven"
   :reuses ["host and self-hosted representations"]
   :why "performance is not a semantic expressiveness choice; a second representation would violate reuse"
   :cost "only measured hot paths are optimized"}}

