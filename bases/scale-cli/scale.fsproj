<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scale</RootNamespace>
    <PublishAot>true</PublishAot>
    <IlcGenerateCompleteTypeMetadata>true</IlcGenerateCompleteTypeMetadata>
    <IlcTrimMetadata>false</IlcTrimMetadata>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <StripSymbols Condition="'$(Configuration)' == 'Release'">true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="entry.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../components/demo/demo/generated/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="demo/generated/%(Filename)%(Extension)" />
    <Content Include="../../components/demo/demo/player.scale" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="demo/player.scale" />
    <Content Include="witnesses/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="witnesses/%(Filename)%(Extension)" />
    <Content Include="snapshots/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Link="snapshots/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../components/core/Scale.Core.fsproj" />
    <ProjectReference Include="../../components/verification/typing/Scale.Typing.fsproj" />
    <ProjectReference Include="../../components/prelude/Scale.Prelude.fsproj" />
    <ProjectReference Include="../../components/ipc/Scale.Ipc.fsproj" />
    <ProjectReference Include="../../components/verification/Scale.Verification.fsproj" />
    <ProjectReference Include="../../components/demo/Scale.Demo.fsproj" />
    <ProjectReference Include="../../components/cli/Scale.Cli.fsproj" />
    <ProjectReference Include="../../components/shell-host/Scale.ShellHost.fsproj" />
    <ProjectReference Include="../../components/book-host/Scale.BookHost.fsproj" />
    <ProjectReference Include="../../components/kernel/Scale.Kernel.fsproj" />
  </ItemGroup>
</Project>
