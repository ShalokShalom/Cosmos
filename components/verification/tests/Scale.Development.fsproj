<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scale</RootNamespace>
    <EnableWriter Condition="'$(EnableWriter)' == '' and '$(Configuration)' == 'Debug'">true</EnableWriter>
    <EnableWriter Condition="'$(EnableWriter)' == ''">false</EnableWriter>
    <DefineConstants Condition="'$(EnableWriter)' == 'true'">$(DefineConstants);ENABLE_WRITER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="properties.fs" />
    <Compile Include="differential.fs" />
    <Compile Include="benchmarks.fs" />
    <Compile Include="tests.fs" />
    <Compile Include="granular-tests.fs" />
    <Compile Include="test-runner.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../core/Scale.Core.fsproj" />
    <ProjectReference Include="../typing/Scale.Typing.fsproj" />
    <ProjectReference Include="../../prelude/Scale.Prelude.fsproj" />
    <ProjectReference Include="../../ipc/Scale.Ipc.fsproj" />
    <ProjectReference Include="../Scale.Verification.fsproj" />
    <ProjectReference Include="../../demo/Scale.Demo.fsproj" />
    <ProjectReference Include="../../cli/Scale.Cli.fsproj" />
    <ProjectReference Include="../../shell-host/Scale.ShellHost.fsproj" />
    <ProjectReference Include="../../book-host/Scale.BookHost.fsproj" />
    <ProjectReference Include="../../kernel/Scale.Kernel.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../ipc/vectors/*.bin" CopyToOutputDirectory="PreserveNewest" Link="wire-vectors/%(Filename)%(Extension)" />
    <Content Include="../../kernel/term-vectors/*.json" CopyToOutputDirectory="PreserveNewest" Link="term-vectors/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="Hedgehog" />
    <PackageReference Include="Verify.Expecto" />
  </ItemGroup>
</Project>
