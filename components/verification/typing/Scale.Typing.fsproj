<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Scale</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="row-types.fs" />
    <Compile Include="label-sets.fs" />
    <Compile Include="record-types.fs" />
    <Compile Include="unification.fs" />
    <Compile Include="type-retrieval.fs" />
    <Compile Include="unification-host.fs" />
    <Compile Include="domain-expression.fs" />
    <Compile Include="type-lattice.fs" />
    <Compile Include="smt.fs" />
    <Compile Include="violations.fs" />
    <Compile Include="nearest-sentence.fs" />
    <Compile Include="presentation.fs" />
    <Compile Include="emitter.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../core/Scale.Core.fsproj" />
    <ProjectReference Include="../../kernel/Scale.Kernel.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hedgehog" />
    <PackageReference Include="Microsoft.Z3" />
  </ItemGroup>
</Project>
