{:schema 1

 :nodes
 [{:id :expression-logic
   :kind :abstraction
   :title "ExpressionLogic"
   :code "ExpressionAst.Expression"
   :role "General expression abstraction: literals, words, calls, partials, holes, pipelines, quotations, blocks, let, lambda, if, match, declarations, conditions, restarts, generics, messages."
   :doc "docs/architecture/general-ir.typ"}
  {:id :pattern-logic
   :kind :abstraction
   :title "PatternLogic"
   :code "PatternAst.Pattern"
   :role "Pattern abstraction: wildcard, role-carrying variables, literals, constructors, typed patterns; templates elaborate to closed patterns."
   :doc "docs/architecture/general-ir.typ"}
  {:id :package-logic
   :kind :abstraction
   :title "PackageLogic"
   :code "PackageAst.PackageDocument"
   :role "Package and unit abstraction: identity, source hash, imports, exports, capabilities, kinds, predicates, ordered units."
   :doc "docs/architecture/general-ir.typ"}
  {:id :symbolic-abstraction
   :kind :abstraction
   :title "SymbolicAbstraction"
   :code "TermIr.Term"
   :role "Interpreter's symbolic term list and quotation body: literal, word, quote, branch, slot, closure, fail."
   :doc "docs/architecture/term-ir.typ"}
  {:id :lowered-abstraction
   :kind :abstraction
   :title "LoweredAbstraction"
   :code "LoweredInstructions.Instruction + LoweredAbstraction"
   :role "Lowered instruction abstraction and VM: literals, slots, calls, closures, tensor operations, branches, failure."
   :doc "docs/kernel/native-dotnet-port.typ"}
  {:id :type-retrieval
   :kind :abstraction
   :title "TypeRetrieval"
   :code "TypeInference"
   :role "Retrieves and elaborates types against a signature table; not a type checker."
   :doc "docs/types/type-inference.typ"}
  {:id :portable-documents
   :kind :contract
   :title "Portable documents"
   :code "TermProgram, ExpressionDocument, PatternDocument, PackageDocument"
   :role "Canonical schema-1 JSON forms used at the image, ABI, persistence, and package boundaries."
   :doc "docs/architecture/general-ir.typ"}
  {:id :domain-expression
   :kind :abstraction
   :title "DomainExpression and SMT"
   :code "DomainExpression, Smt"
   :role "Verification abstraction: typed domain expressions, sorts, guards, obligations, and SMT encodings."
   :doc "docs/types/type-lattice.typ"}
  {:id :image-values
   :kind :runtime
   :title "Image values"
   :code "Tensor, EntryIdentity, Store, Lexicon"
   :role "Runtime value model; not code, but the representation every abstraction lowers into."
   :doc "docs/runtime/memory-model.typ"}
  {:id :execution-state
   :kind :runtime
   :title "Execution state"
   :code "KernelState, EvaluationState"
   :role "State, not code: store, stack, program, roots, frames, scheduler, and effects."
   :doc "docs/runtime/evaluator-slicing-and-scheduler.typ"}]

 :edges
 [{:from :expression-logic :to :pattern-logic :kind :embeds
   :rationale "PatternMatch clauses carry PatternLogic patterns."}
  {:from :expression-logic :to :lowered-abstraction :kind :lowers-to
   :rationale "EvaluatorLowering maps the expression subset to instructions."}
  {:from :package-logic :to :expression-logic :kind :contains
   :rationale "A PackageUnit root is an ExpressionLogic node."}
  {:from :expression-logic :to :portable-documents :kind :serializes-to
   :rationale "ExpressionPortable writes the canonical expression document."}
  {:from :pattern-logic :to :portable-documents :kind :serializes-to
   :rationale "PatternPortable writes the canonical pattern document."}
  {:from :package-logic :to :portable-documents :kind :serializes-to
   :rationale "PackagePortable writes the canonical package document."}
  {:from :expression-logic :to :type-retrieval :kind :inferred-by
   :rationale "TypeInference elaborates against the signature table."}
  {:from :lowered-abstraction :to :image-values :kind :executes-on
   :rationale "The VM reads and writes the image store."}
  {:from :symbolic-abstraction :to :image-values :kind :executes-on
   :rationale "The interpreter reads and writes the image store."}
  {:from :domain-expression :to :image-values :kind :projects-to
   :rationale "Verification expressions project into the image value model."}]

