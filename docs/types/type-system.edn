 :assessment
 {:scope "pure-value refactor of the verification lattice"
  :feasibility
  {:verdict :feasible
   :reasons ["the lattice is already immutable host data"
             "public records and validate are a small, local change"
             "product composition is a pure concatenation plus validation"
             "the readers continue to consume the same validated shape"]
   :risks ["direct construction bypasses validation unless callers call validate"
           "sum composition needs reader semantics before it can execute"]}
  :realisticness
  {:verdict :realistic-for-host-tooling
   :reasons ["the refactor preserves the D25 readers and pinned artifacts"
             "pure values are directly inspectable and transformable by F# tooling"
             "the change is tested by examples, a property, and an integration check"]
   :limits ["it is not image-resident"
            "it is not a macro surface"
            "it does not bridge to runtime sorts or static types"
            "public construction makes validate a caller obligation"]}
  :practicability
  {:verdict :practicable-for-inspection-composition-and-serialization
   :reasons ["host tools can inspect and compose lattices without private access"
             "product is usable immediately"
             "validate gives a checked boundary for transformed values"
             "a canonical data document round-trips through a checked reader"]
   :not-yet-practicable ["sum-reader semantics"
                         "D12/P4 bridges"]}}

