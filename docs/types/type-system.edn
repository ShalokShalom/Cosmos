   "non-representable threshold" "guard of the wrong field or sort" "guard that empties a finite field"
   "symbolic field in a finite generator" "named guard without a resolver" "sum lattice execution"]
  :static
  ["OccursCheck" "TypeMismatch" "ArityMismatch" "EffectMismatch" "EffectOccursCheck"
   "EffectSubtractionOpen" "RowOccursCheck" "RowLacksViolation" "DuplicateLabel" "UnknownField" "KindMismatch"
   "UnknownWord" "AmbiguousWord" "UnsupportedExpression"]}

